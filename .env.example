# Copy to `.env` and fill in real values to enable the Seismic ribbon tab's "Upload Live"
# feature (see crates/livedoc/src/upload.rs). Without a `.env` (or these vars set some other
# way), Upload Live fails at once with a clear setup message in the toast — everything else in
# DeckCraft works fine either way. Loaded automatically on desktop app startup (apps/deckcraft);
# never read on wasm (deckcraft-web never links the upload module at all).

# --- Required ---
SEISMIC_TENANT=
SEISMIC_CLIENT_ID=
SEISMIC_CLIENT_SECRET=
SEISMIC_PARENT_FOLDER_ID=
SEISMIC_USER_ID=
SEISMIC_USER_NAME=
# Your environment's endpoints (ask your Seismic admin; there are no built-in defaults)
SEISMIC_AUTH_BASE=
SEISMIC_BSS_BASE=
SEISMIC_CM_BASE=

# --- Optional (defaults shown) ---
# SEISMIC_SCOPE=library upload
# SEISMIC_BSS_OWNER=ccp
# SEISMIC_TEAM_SITE_ID=1
# SEISMIC_FORM_SERVICE_BASE=https://{tenant}.seismic.com
